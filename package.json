{
  "name": "passvault",
  "private": true,
  "version": "0.1.0",
  "description": "PassVault \u2014 end-to-end encrypted password and developer-secrets manager (web, browser extension, macOS desktop).",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:packages": "pnpm -r --filter './packages/*' run build",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "lint": "eslint .",
    "dev:db": "bash scripts/dev-postgres.sh start",
    "dev:api": "pnpm --filter @passvault/api dev",
    "dev:web": "pnpm --filter @passvault/web dev",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@nestjs/core"
    ],
    "overrides": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
