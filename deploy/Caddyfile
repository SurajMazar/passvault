# PassVault edge: TLS termination, security headers, static web app, /api reverse proxy.
# Caddy obtains and renews certificates automatically for public domains (ACME).
# For a local rehearsal use PV_DOMAIN=localhost (Caddy then issues a local CA cert).
{
	email {$PV_ACME_EMAIL:admin@example.com}
	servers {
		trusted_proxies static private_ranges
	}
}

{$PV_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
	}

	# API (NestJS). Request bodies are never logged by Caddy (default access log is off).
	handle /api/* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Web dashboard (static, built with VITE_API_URL=https://<PV_DOMAIN>).
	handle {
		root * /srv
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html /recover
		header @html Cache-Control "no-cache"
		try_files {path} {path}/index.html /index.html
		file_server
	}
}
