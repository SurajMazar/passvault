# PassVault — generated by deploy/server/setup.sh from nginx.conf.template.
# Static web app from ${PV_WEB_ROOT}; /api proxied to the API container on 127.0.0.1:${PV_API_PORT}.

server {
    listen 80;
    listen [::]:80;
    server_name ${PV_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${PV_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/passvault/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/passvault/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:passvault_ssl:10m;
    server_tokens off;

    client_max_body_size 3m;
    access_log /var/log/nginx/passvault.access.log;
    error_log  /var/log/nginx/passvault.error.log warn;

    # API (NestJS). The API sets its own restrictive headers.
    location /api/ {
        proxy_pass http://127.0.0.1:${PV_API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwrite (never append) so clients cannot spoof their address; the API trusts one proxy hop.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    }

    # Web dashboard (static). Same headers as deploy/Caddyfile.
    root ${PV_WEB_ROOT};
    index index.html;
    location /assets/ {
        include /etc/nginx/snippets/passvault-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    location / {
        include /etc/nginx/snippets/passvault-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
