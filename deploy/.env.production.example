# Production configuration for deploy/compose.prod.yaml. Copy to deploy/.env.production
# (gitignored), fill in every value, and keep the file owner-readable only (chmod 600).
# Generate secrets independently:  openssl rand -base64 32   (POSTGRES_PASSWORD: openssl rand -hex 24)

# Public hostname (DNS A/AAAA record must point at this host; ports 80 and 443 reachable for ACME)
PV_DOMAIN=vault.example.com
PV_ACME_EMAIL=ops@example.com

POSTGRES_PASSWORD=
MFA_ENCRYPTION_KEY=
RECOVERY_CODE_PEPPER=
PRELOGIN_SECRET=

# Exact origins allowed to call the API from browsers:
#  - the web dashboard (same origin as PV_DOMAIN)
#  - the desktop app (fixed loopback origin of the Neutralino window)
#  - the published browser extension (chrome-extension://<extension id from the store>)
CORS_ORIGINS=https://vault.example.com,http://localhost:47391,chrome-extension://REPLACE_WITH_EXTENSION_ID

# Transactional email (SPF/DKIM/DMARC configured for the sending domain)
MAIL_FROM=PassVault <no-reply@vault.example.com>
SMTP_HOST=smtp.example.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=

LOG_LEVEL=info
MIGRATE_ON_START=true
