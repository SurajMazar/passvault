{
  "name": "@passvault/e2e-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Records an end-to-end product walkthrough with Playwright and encodes it with ffmpeg.",
  "scripts": {
    "record": "tsx src/record.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:save-prompt": "tsx src/save-prompt-check.ts",
    "tour:tts": "tsx src/tour/tts.ts",
    "tour:record": "tsx src/tour/record.ts",
    "check:server-switch": "tsx src/server-switch-check.ts",
    "check:save-prompt-extension": "tsx src/save-prompt-extension-check.ts"
  },
  "devDependencies": {
    "@passvault/sync": "workspace:*",
    "@passvault/types": "workspace:*",
    "@passvault/vault-core": "workspace:*",
    "kokoro-js": "1.2.1",
    "otpauth": "9.5.2",
    "playwright": "1.64.0"
  }
}
