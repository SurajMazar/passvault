# Environment for `podman compose` (compose.yaml). Copy to .env (gitignored) and fill in.
# There are NO default secrets: compose refuses to start until these are set.
# Generate each secret independently, e.g.:
#   openssl rand -hex 24      (POSTGRES_PASSWORD — hex keeps the DATABASE_URL valid)
#   openssl rand -base64 32   (the three API secrets)

# PostgreSQL superuser password for the bundled database container.
POSTGRES_PASSWORD=

# AES-256-GCM key for TOTP secrets at rest: exactly 32 random bytes, base64.
# Losing it disables every user's MFA (operator MFA reset needed). Back it up separately from DB backups.
MFA_ENCRYPTION_KEY=
# HMAC pepper for MFA recovery codes (>= 32 random bytes). Rotating it invalidates all recovery codes.
RECOVERY_CODE_PEPPER=
# HMAC key for deterministic fake prelogin KDF params (>= 32 random bytes). Keep stable.
PRELOGIN_SECRET=

# Where links in emails point (web app origin).
WEB_APP_URL=http://localhost:5173
# Exact allowed browser origins (comma-separated): web app, desktop app, extension (chrome-extension://<id>).
CORS_ORIGINS=http://localhost:5173,http://localhost:47391

# development | production  (production requires https WEB_APP_URL and SMTP, which compose provides via Mailpit)
API_NODE_ENV=development
API_PORT=3000
MAILPIT_UI_PORT=8025
LOG_LEVEL=info
# Set to the number of trusted reverse-proxy hops (e.g. 1) when running behind a proxy.
TRUST_PROXY=false
