{
  "name": "@passvault/desktop",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "PassVault macOS desktop app (Neutralinojs shell + pv-helper extension).",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:ui": "vite build --watch --mode development",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "package": "bash scripts/build.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@neutralinojs/lib": "6.10.0",
    "@passvault/app": "workspace:*",
    "@passvault/crypto": "workspace:*",
    "@passvault/sync": "workspace:*",
    "@passvault/types": "workspace:*",
    "@passvault/ui": "workspace:*",
    "@passvault/vault-core": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@neutralinojs/neu": "11.7.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "vite": "7.3.7"
  }
}
