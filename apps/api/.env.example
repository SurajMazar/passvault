# PassVault API configuration (copy to apps/api/.env for local development; .env is gitignored).
# The server validates this at startup and refuses to boot with missing/weak secrets.
# There are NO default secrets. Generate each one independently:  openssl rand -base64 32

# development | production | test
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Local cluster: bash scripts/dev-postgres.sh url        (compose sets this itself)
DATABASE_URL=postgresql://passvault:REPLACE_ME@127.0.0.1:54329/passvault

# AES-256-GCM key for TOTP secrets at rest — exactly 32 bytes, base64. Store separately from DB backups.
MFA_ENCRYPTION_KEY=
# HMAC-SHA256 pepper for MFA recovery codes (>= 32 bytes). Changing it invalidates all recovery codes.
RECOVERY_CODE_PEPPER=
# HMAC key for deterministic fake prelogin KDF params of unknown emails (>= 32 bytes). Keep stable.
PRELOGIN_SECRET=

# Origin of the web app; recovery links are <WEB_APP_URL>/recover#token=… (https in production)
WEB_APP_URL=http://localhost:5173

# smtp (production) | console (dev only, prints mail to stdout) | memory (tests only)
MAIL_TRANSPORT=console
MAIL_FROM=PassVault <no-reply@passvault.invalid>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# Exact origins, comma-separated: web app, desktop app, browser extension (chrome-extension://<id>)
CORS_ORIGINS=http://localhost:5173,http://localhost:47391
# Express "trust proxy": false | true | <hop count> | <subnet list>. Set when behind a reverse proxy.
TRUST_PROXY=false

SESSION_TTL_HOURS=720
SESSION_IDLE_MINUTES=10080
RECORD_HISTORY_LIMIT=50
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Server-side Argon2id for authKey/recoveryAuthKey. Minimum outside NODE_ENV=test:
# OPSLIMIT_INTERACTIVE (2) / MEMLIMIT_INTERACTIVE (67108864).
AUTH_HASH_OPSLIMIT=2
AUTH_HASH_MEMLIMIT=67108864

RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_EMAIL_PER_15_MINUTES=10
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=15
# Run background jobs in this instance (set false on extra replicas)
JOBS_ENABLED=true
BODY_LIMIT=3mb
