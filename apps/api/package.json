{
  "name": "@passvault/api",
  "version": "0.1.0",
  "private": true,
  "description": "PassVault backend API (NestJS + Prisma + PostgreSQL). Stores only client-side encrypted envelopes.",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "predev": "pnpm --filter @passvault/types build && pnpm --filter @passvault/validation build && prisma generate",
    "dev": "node scripts/dev.mjs",
    "prebuild": "pnpm --filter @passvault/types build && pnpm --filter @passvault/validation build && prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "pretest": "pnpm --filter @passvault/types build && pnpm --filter @passvault/validation build && prisma generate",
    "test": "vitest run",
    "pretypecheck": "pnpm --filter @passvault/types build && pnpm --filter @passvault/validation build && prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "cli:reset-mfa": "tsx --env-file-if-exists=.env src/cli/reset-mfa.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/throttler": "6.7.1",
    "@passvault/types": "workspace:*",
    "@passvault/validation": "workspace:*",
    "@prisma/client": "6.19.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "libsodium-wrappers-sumo": "0.8.4",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.0.10",
    "otpauth": "9.5.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@passvault/crypto": "workspace:*",
    "@swc/core": "1.16.13",
    "@types/express": "5.0.6",
    "@types/libsodium-wrappers-sumo": "0.8.2",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
